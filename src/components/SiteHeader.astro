
---
const categories = [
  "News",
  "Politics",
  "Entertainment",
  "Celebrity News",
  "Trending Stories",
  "Sports",
  "Business",
  "Lifestyle",
  "Technology",
];

const categorySlug = (category: string) => {
  if (category === "Trending Stories") return "trending";
  return category.toLowerCase().replaceAll(" ", "-");
};
---

<div class="utility-bar">
  <div class="container utility-inner">
    <span>
      {new Date().toLocaleDateString("en-NG", {
        weekday: "long",
        day: "numeric",
        month: "long",
        year: "numeric",
      })}
    </span>
    <span class="utility-note">Real stories. Nigeria. Daily.</span>
  </div>
</div>

<header class="site-header">
  <div class="container masthead">
    <a href="/" class="brand" aria-label="PTO Info Daily homepage">
      <img src="/pto-logo.png" alt="PTO Info Daily" width="119" height="80" />
    </a>

    <div class="masthead-wordmark">
      <a href="/" aria-label="PTO Info Daily homepage">PTOINFODAILY</a>
      <span>News. People. Perspectives.</span>
    </div>

    <form class="header-search" action="/search/" method="get" role="search">
      <label class="visually-hidden" for="site-search">Search PTO Info Daily</label>
      <input
        id="site-search"
        type="search"
        name="q"
        placeholder="Search news, people and topics..."
        required
      />
      <button type="submit" aria-label="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="10.8" cy="10.8" r="6.8"></circle>
          <path d="m16 16 4.5 4.5"></path>
        </svg>
      </button>
    </form>
  </div>

  <nav class="main-nav" aria-label="Main navigation">
    <div class="container nav-inner">
      <a href="/" class="nav-home">Home</a>

      <div class="nav-links" id="primary-navigation">
        {categories.map((category) => (
          <a href={`/category/${categorySlug(category)}/`}>
            {category}
          </a>
        ))}
        <a href="/leadership/">Leadership</a>
        <a href="/sponsorship/" class="sponsor-nav-link">
          Sponsor PTO Info Daily
        </a>
      </div>

      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-navigation"
        aria-label="Open navigation"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>
</header>

<style>
  .utility-bar {
    background: #102a56;
    color: #fff;
    font-size: 11px;
    letter-spacing: .035em;
  }

  .container {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }

  .utility-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 34px;
    gap: 16px;
  }

  .utility-note {
    color: #c3d7ff;
  }

  .site-header {
    background: #fff;
  }

  .masthead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(200px, 1.1fr) minmax(0, 1fr);
    align-items: center;
    min-height: 120px;
    gap: 28px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    min-width: 0;
  }

  .brand img {
    display: block;
    width: auto;
    height: 66px;
    max-width: 100%;
    object-fit: contain;
    object-position: left center;
  }

  .masthead-wordmark {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
    text-align: center;
  }

  .masthead-wordmark a {
    color: #102a56;
    font-family: Montserrat, Arial, sans-serif;
    font-size: clamp(21px, 2.3vw, 32px);
    font-weight: 800;
    letter-spacing: .035em;
    line-height: 1.15;
    text-decoration: none;
    white-space: nowrap;
  }

  .masthead-wordmark span {
    margin-top: 7px;
    color: #667085;
    font-size: 10px;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .header-search {
    display: flex;
    justify-self: end;
    width: 100%;
    min-width: 0;
    height: 44px;
    border: 1px solid #dce4f0;
    background: #fff;
  }

  .header-search:focus-within {
    border-color: #155eef;
  }

  .header-search input {
    flex: 1;
    width: 0;
    min-width: 0;
    padding: 0 12px;
    border: 0;
    outline: 0;
    color: #172033;
    background: transparent;
    font-family: inherit;
    font-size: 12px;
  }

  .header-search input::placeholder {
    color: #7b8596;
  }

  .header-search button {
    display: grid;
    place-items: center;
    flex: 0 0 44px;
    border: 0;
    background: #155eef;
    color: #fff;
    cursor: pointer;
  }

  .header-search button:hover {
    background: #102a56;
  }

  .header-search svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .main-nav {
    background: #155eef;
    color: #fff;
  }

  .nav-inner {
    display: flex;
    align-items: stretch;
    min-height: 48px;
  }

  .nav-home {
    display: flex;
    align-items: center;
    padding: 0 19px;
    margin-right: 10px;
    background: #102a56;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: stretch;
    gap: 0;
    flex: 1;
  }

  .nav-links a {
    display: flex;
    align-items: center;
    padding: 0 8px;
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background .2s ease;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    background: #102a56;
  }

  .nav-links .sponsor-nav-link {
    margin-left: auto;
    background: #102a56;
  }

  .menu-toggle {
    display: none;
    align-self: center;
    width: 42px;
    height: 38px;
    border: 1px solid rgba(255,255,255,.45);
    background: transparent;
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    width: 20px;
    height: 2px;
    margin: 4px auto;
    background: #fff;
  }

  @media (max-width: 1100px) {
    .masthead {
      grid-template-columns: minmax(0, .9fr) minmax(190px, 1fr) minmax(0, 1fr);
      gap: 18px;
    }

    .brand img {
      height: 58px;
    }

    .masthead-wordmark a {
      font-size: 23px;
    }

    .nav-links a {
      padding-inline: 6px;
      font-size: 9px;
    }
  }

  /* The full category menu needs about 800px. Below 900px it switches to
     the menu button so the page never scrolls sideways. */
  @media (max-width: 900px) {
    .main-nav {
      position: relative;
    }

    .nav-inner {
      justify-content: space-between;
      min-height: 48px;
    }

    .menu-toggle {
      display: block;
    }

    .nav-links {
      display: none;
      position: absolute;
      z-index: 20;
      /* Open below the blue bar so the Home link and menu button stay usable. */
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      background: #155eef;
      box-shadow: 0 10px 20px rgba(16,42,86,.18);
    }

    .nav-links.nav-open {
      display: flex;
    }

    .nav-links a {
      min-height: 42px;
      padding: 0 20px;
      font-size: 12px;
      border-top: 1px solid rgba(255,255,255,.12);
    }

    .nav-links .sponsor-nav-link {
      margin-left: 0;
    }
  }

  @media (max-width: 760px) {
    .container {
      width: min(100% - 28px, 1180px);
    }

    .masthead {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      min-height: auto;
      padding-top: 18px;
      padding-bottom: 16px;
      gap: 16px 12px;
    }

    .brand img {
      height: 48px;
      max-width: 100%;
    }

    .masthead-wordmark {
      align-items: flex-end;
      text-align: right;
    }

    .masthead-wordmark a {
      font-size: clamp(17px, 4vw, 24px);
    }

    .masthead-wordmark span {
      margin-top: 5px;
      font-size: 8px;
      letter-spacing: .04em;
    }

    .header-search {
      grid-column: 1 / -1;
      justify-self: stretch;
      height: 42px;
    }

    .header-search input {
      font-size: 13px;
    }
  }

  @media (max-width: 420px) {
    .utility-bar {
      font-size: 9px;
    }

    .utility-inner {
      gap: 8px;
    }

    .masthead {
      gap: 14px 8px;
    }

    .brand img {
      height: 40px;
    }

    .masthead-wordmark a {
      font-size: 17px;
      letter-spacing: 0;
    }

    .masthead-wordmark span {
      font-size: 7px;
    }
  }
</style>

<script>
  const menuButton =
    document.querySelector<HTMLButtonElement>(".menu-toggle");
  const navLinks =
    document.querySelector<HTMLElement>("#primary-navigation");

  menuButton?.addEventListener("click", () => {
    const isOpen = menuButton.getAttribute("aria-expanded") === "true";

    menuButton.setAttribute("aria-expanded", String(!isOpen));
    menuButton.setAttribute(
      "aria-label",
      isOpen ? "Open navigation" : "Close navigation"
    );
    navLinks?.classList.toggle("nav-open", !isOpen);
  });
</script>
