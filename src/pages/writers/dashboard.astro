---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';

export const prerender = false;

const session = Astro.session;

if (!session) {
  return new Response('Session service unavailable.', { status: 503 });
}

const authorId = await session.get<string>('authorId');
const authorRole = await session.get<string>('authorRole');
const authorName = await session.get<string>('authorName');

if (!authorId || !authorRole || !authorName) {
  return Astro.redirect('/writers/login/', 303);
}

if (!['writer', 'editor', 'admin'].includes(authorRole)) {
  return new Response('Access denied.', { status: 403 });
}

const author = await env.DB.prepare(
  'SELECT id, display_name, role, active FROM authors WHERE id = ? LIMIT 1'
)
  .bind(authorId)
  .first<{
    id: string;
    display_name: string;
    role: string;
    active: number;
  }>();

if (!author || author.active !== 1 || author.role !== authorRole) {
  await session.destroy();
  return Astro.redirect('/writers/login/', 303);
}

const greetingName = author.display_name;

const categories = [
  { value: 'news', label: 'News' },
  { value: 'politics', label: 'Politics' },
  { value: 'entertainment', label: 'Entertainment' },
  { value: 'celebrity-news', label: 'Celebrity News' },
  { value: 'trending', label: 'Trending' },
  { value: 'sports', label: 'Sports' },
  { value: 'business', label: 'Business' },
  { value: 'lifestyle', label: 'Lifestyle' },
  { value: 'technology', label: 'Technology' },
];
---

<BaseLayout
  title="Writer Dashboard | PTO Info Daily"
  description="Private article management dashboard for PTO Info Daily writers."
  noIndex={true}
>
  <main class="dashboard" data-author-role={authorRole}>
    <header class="dashboard-header">
      <div>
        <p class="eyebrow">PTO INFO DAILY</p>
        <h1>Writer dashboard</h1>
        <p class="welcome">Welcome back, {greetingName}.</p>
        <p class="role-label">Account role: {authorRole}</p>
      </div>

      <div class="header-actions">
        {authorRole === 'admin' || authorRole === 'editor' ? (
          <a class="admin-link" href="/admin/">Administration</a>
        ) : null}

        <form method="POST" action="/writers/logout/">
          <button class="logout-button" type="submit">Sign out</button>
        </form>
      </div>
    </header>

    <section class="workspace">
      <div class="section-heading">
        <div>
          <p class="eyebrow">EDITORIAL WORKSPACE</p>
          <h2 id="editor-heading-title">Write an article</h2>
          <p>Compose and save your article using the rich-text editor.</p>
        </div>
      </div>

      <form id="article-form" class="article-form">
        <label for="title">Article title</label>
        <input
          id="title"
          name="title"
          type="text"
          minlength="5"
          maxlength="180"
          placeholder="Enter a clear, descriptive headline"
          required
        />

        <label for="description">Short description</label>
        <textarea
          id="description"
          name="description"
          minlength="20"
          maxlength="320"
          rows="3"
          placeholder="Write a short summary of the article"
          required
        ></textarea>

        <label for="category">Category</label>
        <select id="category" name="category" required>
          {categories.map((category) => (
            <option value={category.value}>{category.label}</option>
          ))}
        </select>

        <fieldset class="hero-field">
          <legend>Featured image</legend>
          <p class="field-hint">
            Shown at the top of the article and on the homepage. JPEG, PNG or
            WebP. Large photos are resized automatically before upload.
          </p>

          <div id="hero-preview" class="hero-preview" hidden>
            <img id="hero-preview-img" alt="Featured image preview" />
          </div>

          <div class="hero-actions">
            <label class="file-button" for="hero-file">
              <span id="hero-choose-label">Choose image</span>
            </label>
            <input
              id="hero-file"
              class="visually-hidden"
              type="file"
              accept="image/jpeg,image/png,image/webp"
            />
            <button id="hero-remove" class="secondary-button" type="button" hidden>
              Remove image
            </button>
          </div>

          <label for="image-alt">Image caption / description</label>
          <input
            id="image-alt"
            type="text"
            maxlength="200"
            placeholder="Describe what the photo shows, and credit the source"
          />

          <p id="hero-message" class="message" role="status" aria-live="polite"></p>
        </fieldset>

        <input
          id="inline-image-file"
          class="visually-hidden"
          type="file"
          accept="image/jpeg,image/png,image/webp"
          tabindex="-1"
          aria-hidden="true"
        />

        <div class="editor-heading">
          <label>Article body</label>
          <span class="editor-note">Rich-text editor</span>
        </div>

        <div class="toolbar" role="toolbar" aria-label="Article formatting">
          <button type="button" data-action="bold" title="Bold"><strong>B</strong></button>
          <button type="button" data-action="italic" title="Italic"><em>I</em></button>
          <button type="button" data-action="underline" title="Underline"><u>U</u></button>
          <span class="toolbar-divider"></span>
          <button type="button" data-action="paragraph" title="Paragraph">P</button>
          <button type="button" data-action="h2" title="Heading 2">H2</button>
          <button type="button" data-action="h3" title="Heading 3">H3</button>
          <span class="toolbar-divider"></span>
          <button type="button" data-action="bullet" title="Bulleted list">• List</button>
          <button type="button" data-action="ordered" title="Numbered list">1. List</button>
          <button type="button" data-action="blockquote" title="Quote">Quote</button>
          <span class="toolbar-divider"></span>
          <button type="button" data-action="align-left" title="Align left">Left</button>
          <button type="button" data-action="align-center" title="Align center">Centre</button>
          <button type="button" data-action="align-right" title="Align right">Right</button>
          <span class="toolbar-divider"></span>
          <button type="button" data-action="link" title="Insert link">Link</button>
          <button type="button" data-action="upload-image" title="Upload an image from your computer">Upload image</button>
          <button type="button" data-action="image" title="Insert image URL">Image URL</button>
          <button type="button" data-action="undo" title="Undo">↶</button>
          <button type="button" data-action="redo" title="Redo">↷</button>
        </div>

        <div
          id="article-editor"
          class="article-editor"
          aria-label="Article content editor"
        ></div>

        <p class="editor-help">
          Use "Upload image" to add a photo from your computer inside the
          article, or "Image URL" for an image already online. Only use
          images you have permission to publish.
        </p>

        <p class="form-help">
          Your article will be saved as a draft. When it is ready, use
          "Submit for review" in your article list below. It will not appear
          publicly until an editor approves and publishes it.
        </p>

        <div class="form-actions">
          <button id="save-button" class="primary-button" type="submit">
            Save draft
          </button>

          <button id="cancel-edit-button" class="secondary-button" type="button" hidden>
            Cancel editing
          </button>
        </div>

        <p id="form-message" class="message" role="status" aria-live="polite"></p>
      </form>
    </section>

    <section class="workspace">
      <div class="section-heading">
        <div>
          <p class="eyebrow">CONTENT MANAGEMENT</p>
          <h2>Your articles</h2>
          <p>Articles saved in the PTO Info Daily database.</p>
        </div>

        <button id="refresh-button" class="secondary-button" type="button">
          Refresh list
        </button>
      </div>

      <p id="list-message" class="message" role="status" aria-live="polite">
        Loading articles...
      </p>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Title</th>
              <th scope="col">Category</th>
              <th scope="col">Publication status</th>
              <th scope="col">Editorial review</th>
              <th scope="col">Last updated</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody id="article-list">
            <tr><td colspan="6">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <a class="home-link" href="/">&#8592; Return to homepage</a>
  </main>
</BaseLayout>

<style>
  .dashboard {
    width: min(1100px, calc(100% - 32px));
    margin: 0 auto;
    padding: 42px 0 64px;
    color: #18212f;
  }

  .dashboard-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .admin-link {
    color: #155eef;
    font-weight: 700;
    text-decoration: none;
  }

  .admin-link:hover { text-decoration: underline; }

  .eyebrow {
    margin: 0 0 8px;
    color: #155eef;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  h1, h2 { margin: 0; line-height: 1.2; }
  h1 { font-size: clamp(2rem, 5vw, 2.8rem); }

  .welcome { margin: 12px 0 4px; color: #4b5563; }
  .role-label {
    margin: 0;
    color: #667085;
    font-size: 0.9rem;
    text-transform: capitalize;
  }

  .logout-button, .primary-button, .secondary-button,
  .action-button {
    border: 0;
    border-radius: 8px;
    cursor: pointer;
    font: inherit;
    font-weight: 700;
    padding: 12px 18px;
  }

  .logout-button, .secondary-button {
    background: #eef1f5;
    color: #18212f;
  }

  .primary-button {
    background: #155eef;
    color: white;
  }

  .primary-button:disabled, .secondary-button:disabled,
  .action-button:disabled {
    cursor: wait;
    opacity: 0.65;
  }

  .workspace {
    margin-top: 24px;
    padding: clamp(18px, 4vw, 30px);
    border: 1px solid #e3e7ed;
    border-radius: 14px;
    background: white;
    box-shadow: 0 8px 28px rgb(16 24 40 / 5%);
  }

  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 24px;
  }

  .section-heading h2 { font-size: 1.5rem; }
  .section-heading p:not(.eyebrow) {
    margin: 8px 0 0;
    color: #667085;
  }

  .article-form { display: grid; gap: 10px; }

  .article-form label {
    margin-top: 8px;
    font-size: 0.94rem;
    font-weight: 750;
  }

  .article-form input, .article-form textarea, .article-form select {
    box-sizing: border-box;
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #cfd5df;
    border-radius: 8px;
    background: white;
    color: #18212f;
    font: inherit;
  }

  .article-form textarea { resize: vertical; line-height: 1.6; }

  .article-form input:focus, .article-form textarea:focus,
  .article-form select:focus {
    outline: 2px solid #155eef;
    outline-offset: 2px;
  }

  .editor-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .editor-note, .editor-help {
    color: #667085;
    font-size: 0.85rem;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 10px;
    border: 1px solid #cfd5df;
    border-radius: 8px 8px 0 0;
    background: #f8fafc;
  }

  .toolbar button {
    min-width: 36px;
    padding: 7px 10px;
    border: 1px solid #d0d5dd;
    border-radius: 6px;
    background: white;
    color: #18212f;
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
  }

  .toolbar button:hover, .toolbar button.is-active {
    background: #e8efff;
    border-color: #155eef;
    color: #155eef;
  }

  .toolbar-divider {
    width: 1px;
    margin: 2px 3px;
    background: #d0d5dd;
  }

  .article-editor {
    min-height: 360px;
    padding: 18px;
    border: 1px solid #cfd5df;
    border-top: 0;
    border-radius: 0 0 8px 8px;
    color: #18212f;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .article-editor:focus-within {
    outline: 2px solid #155eef;
    outline-offset: 2px;
  }

  /* The editor's content is created by Tiptap in the browser, so these
     rules use :global() to reach it (Astro's scoped CSS otherwise can't). */
  .article-editor :global(.ProseMirror) { min-height: 320px; outline: none; }
  .article-editor :global(.ProseMirror p) { margin: 0 0 1em; }
  .article-editor :global(.ProseMirror > p:only-child:has(> br.ProseMirror-trailingBreak:only-child))::before {
    content: 'Start writing your article here...';
    float: left;
    height: 0;
    color: #98a2b3;
    pointer-events: none;
  }
  .article-editor :global(.ProseMirror h2),
  .article-editor :global(.ProseMirror h3) { margin: 1.2em 0 0.6em; }
  .article-editor :global(.ProseMirror blockquote) {
    margin: 1em 0;
    padding: 8px 16px;
    border-left: 4px solid #155eef;
    background: #f8fafc;
  }
  .article-editor :global(.ProseMirror img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 18px auto;
    border-radius: 8px;
  }
  .article-editor :global(.ProseMirror img.ProseMirror-selectednode) {
    outline: 3px solid #155eef;
  }
  .article-editor :global(.ProseMirror a) { color: #155eef; text-decoration: underline; }
  .article-editor :global(.ProseMirror ul),
  .article-editor :global(.ProseMirror ol) { padding-left: 28px; }

  .hero-field {
    margin: 18px 0 6px;
    padding: 16px 18px 6px;
    border: 1px solid #cfd5df;
    border-radius: 8px;
    min-width: 0;
  }

  .hero-field legend {
    padding: 0 6px;
    font-weight: 700;
  }

  .field-hint {
    margin: 0 0 12px;
    color: #667085;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .hero-preview {
    margin: 0 0 12px;
    overflow: hidden;
    border-radius: 8px;
    background: #f2f4f7;
  }

  .hero-preview img {
    display: block;
    width: 100%;
    max-height: 320px;
    object-fit: cover;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 14px;
  }

  .file-button {
    display: inline-flex;
    align-items: center;
    padding: 10px 16px;
    border-radius: 8px;
    background: #e8efff;
    color: #1849a9;
    cursor: pointer;
    font-weight: 700;
  }

  .file-button:hover { background: #d6e4ff; }

  .hero-field:has(#hero-file:focus-visible) .file-button {
    outline: 2px solid #155eef;
    outline-offset: 2px;
  }

  .hero-field.is-busy .file-button {
    cursor: wait;
    opacity: 0.65;
  }

  .article-form input.visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .editor-help, .form-help {
    margin: 8px 0;
    line-height: 1.6;
  }

  .form-help, .message { color: #667085; }
  .message { line-height: 1.5; }
  .message.error { color: #b42318; }
  .message.success { color: #067647; }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }

  .table-wrap { width: 100%; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; text-align: left; }
  th, td {
    padding: 14px 12px;
    border-bottom: 1px solid #e5e7eb;
    vertical-align: top;
  }
  th { color: #475467; font-size: 0.84rem; white-space: nowrap; }
  td { font-size: 0.93rem; }

  /* Rows in #article-list are built by JavaScript, so Astro's scoped
     styles don't reach them. These rules use :global() inside the list. */
  #article-list :global(td) {
    padding: 14px 12px;
    border-bottom: 1px solid #e5e7eb;
    vertical-align: top;
    font-size: 0.93rem;
  }

  #article-list :global(.action-button) {
    border: 0;
    border-radius: 8px;
    cursor: pointer;
    font: inherit;
    font-weight: 700;
  }

  #article-list :global(.action-button:disabled) {
    cursor: wait;
    opacity: 0.65;
  }

  #article-list :global(.status) {
    display: inline-block;
    padding: 4px 9px;
    border-radius: 999px;
    background: #fff1d6;
    color: #854d0e;
    font-size: 0.8rem;
    font-weight: 750;
    text-transform: capitalize;
    white-space: nowrap;
  }

  #article-list :global(.status.published), #article-list :global(.status.approved) {
    background: #dcfae6;
    color: #067647;
  }

  #article-list :global(.status.submitted) {
    background: #e8efff;
    color: #1849a9;
  }

  #article-list :global(.status.changes_requested) {
    background: #fee4e2;
    color: #b42318;
  }

  #article-list :global(.status.draft) { background: #f2f4f7; color: #475467; }

  #article-list :global(.article-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    min-width: 125px;
  }

  #article-list :global(.action-button) {
    padding: 7px 10px;
    font-size: 0.82rem;
  }

  #article-list :global(.edit-button) {
    background: #e8efff;
    color: #1849a9;
  }

  #article-list :global(.delete-button) {
    background: #fee4e2;
    color: #b42318;
  }

  #article-list :global(.submit-review-button) {
    background: #155eef;
    color: white;
  }

  #article-list :global(.locked-note) {
    color: #667085;
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .home-link {
    display: inline-block;
    margin-top: 28px;
    color: #155eef;
    font-weight: 700;
    text-decoration: none;
  }
  .home-link:hover { text-decoration: underline; }

  [hidden] { display: none !important; }

  @media (max-width: 640px) {
    .dashboard-header, .section-heading {
      align-items: stretch;
      flex-direction: column;
    }

    .header-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .logout-button, .secondary-button { width: 100%; }
  }
</style>

<script>
  import { Editor } from '@tiptap/core';
  import StarterKit from '@tiptap/starter-kit';
  import Link from '@tiptap/extension-link';
  import Image from '@tiptap/extension-image';
  import TextAlign from '@tiptap/extension-text-align';
  import Underline from '@tiptap/extension-underline';

  type Article = {
    id: string;
    slug: string;
    title: string;
    description: string;
    category: string;
    status: string;
    review_status?: string;
    created_at: string;
    updated_at: string;
    published_at: string | null;
  };

  type ArticleDetails = Article & {
    body: string;
    hero_image_key?: string | null;
    image_alt?: string | null;
  };

  const form = document.querySelector<HTMLFormElement>('#article-form');
  const saveButton = document.querySelector<HTMLButtonElement>('#save-button');
  const cancelEditButton = document.querySelector<HTMLButtonElement>('#cancel-edit-button');
  const formMessage = document.querySelector<HTMLParagraphElement>('#form-message');
  const listMessage = document.querySelector<HTMLParagraphElement>('#list-message');
  const articleList = document.querySelector<HTMLTableSectionElement>('#article-list');
  const refreshButton = document.querySelector<HTMLButtonElement>('#refresh-button');
  const editorElement = document.querySelector<HTMLDivElement>('#article-editor');
  const dashboard = document.querySelector<HTMLElement>('.dashboard');
  const authorRole = dashboard?.dataset.authorRole ?? 'writer';
  const headingTitle = document.querySelector<HTMLHeadingElement>('#editor-heading-title');

  const titleInput = document.querySelector<HTMLInputElement>('#title');
  const descriptionInput = document.querySelector<HTMLTextAreaElement>('#description');

  // Corrected category selector typing.
  const categoryInput = document.getElementById('category') as HTMLSelectElement | null;

  let currentEditingId: string | null = null;

  // ---------- Image uploads ----------
  const heroField = document.querySelector<HTMLFieldSetElement>('.hero-field');
  const heroFileInput = document.querySelector<HTMLInputElement>('#hero-file');
  const heroPreview = document.querySelector<HTMLDivElement>('#hero-preview');
  const heroPreviewImg = document.querySelector<HTMLImageElement>('#hero-preview-img');
  const heroRemoveButton = document.querySelector<HTMLButtonElement>('#hero-remove');
  const heroChooseLabel = document.querySelector<HTMLSpanElement>('#hero-choose-label');
  const heroMessage = document.querySelector<HTMLParagraphElement>('#hero-message');
  const imageAltInput = document.querySelector<HTMLInputElement>('#image-alt');
  const inlineImageInput = document.querySelector<HTMLInputElement>('#inline-image-file');

  const MEDIA_KEY_PATTERN =
    /^img\/\d{4}\/\d{2}\/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\.(webp|jpg|png)$/;
  const ACCEPTED_TYPES = ['image/jpeg', 'image/png', 'image/webp'];
  const MAX_ORIGINAL_BYTES = 20 * 1024 * 1024; // what the writer may pick
  const MAX_UPLOAD_BYTES = 1.9 * 1024 * 1024; // what we send (server limit is 2 MB)

  // Featured image state. `heroImageChanged` is false while editing an article
  // whose image hasn't been touched, so the server keeps the current one.
  let heroImageKey: string | null = null;
  let heroImageChanged = false;
  let heroUploadToken = 0;
  let heroObjectUrl: string | null = null;

  function canvasToBlob(
    canvas: HTMLCanvasElement,
    type: string,
    quality: number,
  ): Promise<Blob | null> {
    return new Promise((resolve) => canvas.toBlob(resolve, type, quality));
  }

  // Resizes to at most `maxSide` pixels and re-encodes as WebP (JPEG on
  // browsers that can't make WebP). This keeps uploads small, which keeps
  // storage within the free plan, and strips camera metadata such as GPS.
  async function prepareImage(file: File): Promise<Blob> {
    if (!ACCEPTED_TYPES.includes(file.type)) {
      throw new Error('Choose a JPEG, PNG or WebP image.');
    }

    if (file.size > MAX_ORIGINAL_BYTES) {
      throw new Error('That image is too large. Choose one under 20 MB.');
    }

    let bitmap: ImageBitmap;

    try {
      bitmap = await createImageBitmap(file);
    } catch {
      throw new Error('That file could not be read as an image.');
    }

    try {
      for (const maxSide of [1600, 1200, 900]) {
        const scale = Math.min(1, maxSide / Math.max(bitmap.width, bitmap.height));
        const canvas = document.createElement('canvas');
        canvas.width = Math.max(1, Math.round(bitmap.width * scale));
        canvas.height = Math.max(1, Math.round(bitmap.height * scale));

        const context = canvas.getContext('2d');
        if (!context) throw new Error('Your browser could not process the image.');

        context.fillStyle = '#ffffff'; // transparent PNGs get a white background
        context.fillRect(0, 0, canvas.width, canvas.height);
        context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);

        for (const quality of [0.82, 0.7]) {
          let blob = await canvasToBlob(canvas, 'image/webp', quality);

          if (!blob || blob.type !== 'image/webp') {
            blob = await canvasToBlob(canvas, 'image/jpeg', quality + 0.03);
          }

          if (blob && blob.size <= MAX_UPLOAD_BYTES) return blob;
        }
      }
    } finally {
      bitmap.close();
    }

    throw new Error('That image could not be made small enough. Try a different photo.');
  }

  async function uploadImage(blob: Blob): Promise<{ key: string; url: string }> {
    const extension = blob.type === 'image/webp' ? 'webp' : 'jpg';
    const body = new FormData();
    body.append('file', blob, `upload.${extension}`);

    const response = await fetch('/api/media', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { Accept: 'application/json' },
      body,
    });

    let data: { key?: string; url?: string; message?: string } = {};

    try {
      data = await response.json();
    } catch {
      // Non-JSON error page.
    }

    if (!response.ok || !data.key || !data.url) {
      throw new Error(data.message || 'The image could not be uploaded.');
    }

    return { key: data.key, url: data.url };
  }

  function setHeroPreview(src: string | null) {
    if (heroObjectUrl) {
      URL.revokeObjectURL(heroObjectUrl);
      heroObjectUrl = null;
    }

    if (heroPreviewImg && src) heroPreviewImg.src = src;
    if (heroPreview) heroPreview.hidden = !src;
    if (heroRemoveButton) heroRemoveButton.hidden = !src;
    if (heroChooseLabel) heroChooseLabel.textContent = src ? 'Replace image' : 'Choose image';
  }

  function setHeroBusy(busy: boolean) {
    heroField?.classList.toggle('is-busy', busy);
    if (heroFileInput) heroFileInput.disabled = busy;
    if (heroRemoveButton) heroRemoveButton.disabled = busy;
    if (saveButton) saveButton.disabled = busy;
  }

  function clearHeroImage() {
    heroUploadToken++;
    heroImageKey = null;
    heroImageChanged = false;
    if (imageAltInput) imageAltInput.value = '';
    if (heroFileInput) heroFileInput.value = '';
    setHeroPreview(null);
    setHeroBusy(false);
    showMessage(heroMessage, '');
  }

  function showStoredHeroImage(key: string | null | undefined, alt: string | null | undefined) {
    clearHeroImage();
    if (!key) return;

    heroImageKey = key;
    const src = MEDIA_KEY_PATTERN.test(key) ? `/media/${key}` : key;
    setHeroPreview(src);
    if (imageAltInput) imageAltInput.value = alt ?? '';
  }

  heroFileInput?.addEventListener('change', async () => {
    const file = heroFileInput.files?.[0];
    if (!file) return;

    const token = ++heroUploadToken;
    setHeroBusy(true);
    showMessage(heroMessage, 'Preparing image…');

    try {
      const blob = await prepareImage(file);
      if (token !== heroUploadToken) return;

      const localUrl = URL.createObjectURL(blob);
      setHeroPreview(localUrl);
      heroObjectUrl = localUrl;

      showMessage(heroMessage, `Uploading (${Math.round(blob.size / 1024)} KB)…`);
      const uploaded = await uploadImage(blob);
      if (token !== heroUploadToken) return;

      heroImageKey = uploaded.key;
      heroImageChanged = true;
      showMessage(
        heroMessage,
        'Image uploaded. Save the article to keep it.',
        'success',
      );
    } catch (error) {
      if (token !== heroUploadToken) return;
      showMessage(
        heroMessage,
        error instanceof Error ? error.message : 'The image could not be uploaded.',
        'error',
      );
      // Go back to whatever image was there before this attempt.
      setHeroPreview(
        heroImageKey
          ? MEDIA_KEY_PATTERN.test(heroImageKey) ? `/media/${heroImageKey}` : heroImageKey
          : null,
      );
    } finally {
      if (token === heroUploadToken) setHeroBusy(false);
      heroFileInput.value = '';
    }
  });

  heroRemoveButton?.addEventListener('click', () => {
    const hadImage = Boolean(heroImageKey);
    clearHeroImage();
    heroImageChanged = hadImage;
    showMessage(heroMessage, hadImage ? 'Image removed. Save the article to confirm.' : '');
  });

  inlineImageInput?.addEventListener('change', async () => {
    const file = inlineImageInput.files?.[0];
    inlineImageInput.value = '';
    if (!file || !editor) return;

    showMessage(formMessage, 'Preparing image…');

    try {
      const blob = await prepareImage(file);
      showMessage(formMessage, `Uploading image (${Math.round(blob.size / 1024)} KB)…`);
      const uploaded = await uploadImage(blob);
      const alt = window.prompt('Briefly describe the image (for readers using screen readers):', '') ?? '';
      editor.chain().focus().setImage({ src: uploaded.url, alt: alt.trim().slice(0, 200) }).run();
      showMessage(formMessage, 'Image added to the article. Remember to save.', 'success');
    } catch (error) {
      showMessage(
        formMessage,
        error instanceof Error ? error.message : 'The image could not be uploaded.',
        'error',
      );
    }
  });

  const editor = editorElement
    ? new Editor({
        element: editorElement,
        extensions: [
          StarterKit,
          Underline,
          Link.configure({
            openOnClick: false,
            autolink: true,
            HTMLAttributes: { rel: 'noopener noreferrer nofollow', target: '_blank' },
          }),
          Image.configure({
            inline: false,
            allowBase64: false,
            HTMLAttributes: { loading: 'lazy' },
          }),
          TextAlign.configure({ types: ['heading', 'paragraph'] }),
        ],
        // Empty start; the hint is a CSS placeholder, so it can't be saved by mistake.
        content: '<p></p>',
        editorProps: {
          attributes: {
            'aria-label': 'Article body',
            spellcheck: 'true',
          },
        },
      })
    : null;

  function showMessage(
    element: HTMLParagraphElement | null,
    message: string,
    kind: 'error' | 'success' | '' = '',
  ) {
    if (!element) return;
    element.textContent = message;
    element.className = `message ${kind}`;
  }

  function formatDate(value: string) {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return value;
    return date.toLocaleString();
  }

  function readableStatus(value: string | undefined) {
    if (!value) return 'Not specified';

    const labels: Record<string, string> = {
      draft: 'Draft',
      submitted: 'Submitted for review',
      changes_requested: 'Changes requested',
      approved: 'Approved',
      published: 'Published',
      unpublished: 'Unpublished',
    };

    return labels[value] ?? value.replaceAll('_', ' ');
  }

  function canEditArticle(article: Article) {
    if (authorRole === 'admin' || authorRole === 'editor') return true;

    return (
      article.status === 'draft' &&
      ['draft', 'changes_requested'].includes(article.review_status ?? 'draft')
    );
  }

  // Drafts and returned articles can be sent to an editor.
  function canSubmitArticle(article: Article) {
    return (
      article.status === 'draft' &&
      ['draft', 'changes_requested'].includes(article.review_status ?? 'draft')
    );
  }

  async function submitArticle(article: Article, button: HTMLButtonElement) {
    if (currentEditingId === article.id) {
      showMessage(
        listMessage,
        'Save or cancel your changes in the editor before submitting this article.',
        'error',
      );
      return;
    }

    const confirmed = window.confirm(
      `Submit "${article.title}" for editorial review?\n\nYou will not be able to edit it again unless an editor returns it to you for changes.`,
    );

    if (!confirmed) return;

    button.disabled = true;
    button.textContent = 'Submitting…';

    try {
      const response = await fetch(`/api/articles/${encodeURIComponent(article.id)}`, {
        method: 'PATCH',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify({ action: 'submit' }),
      });

      const data: { message?: string } = await response.json();

      if (!response.ok) {
        throw new Error(data.message || 'The article could not be submitted.');
      }

      await loadArticles();
      showMessage(listMessage, data.message || 'Article submitted for review.', 'success');
    } catch (error) {
      showMessage(
        listMessage,
        error instanceof Error ? error.message : 'The article could not be submitted.',
        'error',
      );
      button.disabled = false;
      button.textContent =
        article.review_status === 'changes_requested' ? 'Resubmit' : 'Submit for review';
    }
  }

  function renderArticles(articles: Article[]) {
    if (!articleList) return;
    articleList.replaceChildren();

    if (articles.length === 0) {
      const row = document.createElement('tr');
      const cell = document.createElement('td');
      cell.colSpan = 6;
      cell.textContent = 'No articles yet. Create your first draft above.';
      row.appendChild(cell);
      articleList.appendChild(row);
      return;
    }

    for (const article of articles) {
      const row = document.createElement('tr');
      const titleCell = document.createElement('td');
      const categoryCell = document.createElement('td');
      const statusCell = document.createElement('td');
      const reviewCell = document.createElement('td');
      const dateCell = document.createElement('td');
      const actionsCell = document.createElement('td');

      titleCell.textContent = article.title;
      categoryCell.textContent = article.category.replaceAll('-', ' ');

      const status = document.createElement('span');
      status.className = `status ${article.status}`;
      status.textContent = readableStatus(article.status);
      statusCell.appendChild(status);

      const review = document.createElement('span');
      review.className = `status ${article.review_status ?? 'draft'}`;
      review.textContent = readableStatus(article.review_status);
      reviewCell.appendChild(review);

      dateCell.textContent = formatDate(article.updated_at);

      const actions = document.createElement('div');
      actions.className = 'article-actions';

      if (canEditArticle(article)) {
        const editButton = document.createElement('button');
        editButton.type = 'button';
        editButton.className = 'action-button edit-button';
        editButton.textContent = 'Edit';
        editButton.addEventListener('click', () => {
          void loadArticleForEditing(article.id);
        });
        actions.appendChild(editButton);

        const deleteButton = document.createElement('button');
        deleteButton.type = 'button';
        deleteButton.className = 'action-button delete-button';
        deleteButton.textContent = 'Delete';
        deleteButton.addEventListener('click', () => {
          void deleteArticle(article);
        });
        actions.appendChild(deleteButton);
      }

      if (canSubmitArticle(article)) {
        const submitButton = document.createElement('button');
        submitButton.type = 'button';
        submitButton.className = 'action-button submit-review-button';
        submitButton.textContent =
          article.review_status === 'changes_requested' ? 'Resubmit' : 'Submit for review';
        submitButton.addEventListener('click', () => {
          void submitArticle(article, submitButton);
        });
        actions.appendChild(submitButton);
      }

      if (!canEditArticle(article)) {
        const note = document.createElement('span');
        note.className = 'locked-note';
        note.textContent =
          article.status === 'published'
            ? 'Published. Contact an editor for corrections.'
            : article.review_status === 'approved'
              ? 'Approved. Waiting to be published.'
              : 'Locked while under review.';
        actions.appendChild(note);
      }

      actionsCell.appendChild(actions);

      row.appendChild(titleCell);
      row.appendChild(categoryCell);
      row.appendChild(statusCell);
      row.appendChild(reviewCell);
      row.appendChild(dateCell);
      row.appendChild(actionsCell);
      articleList.appendChild(row);
    }
  }

  async function loadArticles() {
    showMessage(listMessage, 'Loading articles...');
    if (refreshButton) refreshButton.disabled = true;

    try {
      const response = await fetch('/api/articles', {
        method: 'GET',
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
      });

      const data: { articles?: Article[]; message?: string } = await response.json();
      if (!response.ok) throw new Error(data.message || 'Unable to load articles.');

      renderArticles(data.articles ?? []);
      showMessage(
        listMessage,
        `${(data.articles ?? []).length} article(s) loaded.`,
        'success',
      );
    } catch (error) {
      showMessage(
        listMessage,
        error instanceof Error ? error.message : 'Unable to load articles.',
        'error',
      );
    } finally {
      if (refreshButton) refreshButton.disabled = false;
    }
  }

  function resetEditor() {
    currentEditingId = null;
    form?.reset();
    editor?.commands.setContent('<p></p>');
    clearHeroImage();

    if (saveButton) saveButton.textContent = 'Save draft';
    if (cancelEditButton) cancelEditButton.hidden = true;
    if (headingTitle) headingTitle.textContent = 'Write an article';

    showMessage(formMessage, '');
  }

  async function loadArticleForEditing(id: string) {
    if (!editor || !titleInput || !descriptionInput || !categoryInput) return;

    showMessage(formMessage, 'Loading article...');
    const previousButtonText = saveButton?.textContent ?? 'Save draft';

    if (saveButton) {
      saveButton.disabled = true;
      saveButton.textContent = 'Loading...';
    }

    try {
      const response = await fetch(`/api/articles/${encodeURIComponent(id)}`, {
        method: 'GET',
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
      });

      const data: { article?: ArticleDetails; message?: string } = await response.json();

      if (!response.ok || !data.article) {
        throw new Error(data.message || 'Unable to load this article for editing.');
      }

      const article = data.article;

      titleInput.value = article.title;
      descriptionInput.value = article.description;
      categoryInput.value = article.category;
      editor.commands.setContent(article.body || '<p></p>');
      showStoredHeroImage(article.hero_image_key, article.image_alt);

      currentEditingId = article.id;

      if (saveButton) saveButton.textContent = 'Save changes';
      if (cancelEditButton) cancelEditButton.hidden = false;
      if (headingTitle) headingTitle.textContent = 'Edit article';

      showMessage(formMessage, `Editing: ${article.title}`, 'success');

      document.querySelector('.article-form')?.scrollIntoView({
        behavior: 'smooth',
        block: 'start',
      });
    } catch (error) {
      showMessage(
        formMessage,
        error instanceof Error ? error.message : 'Unable to load this article.',
        'error',
      );
    } finally {
      if (saveButton) {
        saveButton.disabled = false;
        if (!currentEditingId) saveButton.textContent = previousButtonText;
      }
    }
  }

  async function deleteArticle(article: Article) {
    const confirmed = window.confirm(
      `Are you sure you want to delete "${article.title}"? This action cannot be undone.`,
    );

    if (!confirmed) return;

    showMessage(listMessage, `Deleting "${article.title}"...`);

    try {
      const response = await fetch(`/api/articles/${encodeURIComponent(article.id)}`, {
        method: 'DELETE',
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
      });

      const data: { message?: string } = await response.json();

      if (!response.ok) {
        throw new Error(data.message || 'Unable to delete this article.');
      }

      if (currentEditingId === article.id) resetEditor();

      showMessage(listMessage, data.message || 'Article deleted.', 'success');
      await loadArticles();
    } catch (error) {
      showMessage(
        listMessage,
        error instanceof Error ? error.message : 'Unable to delete this article.',
        'error',
      );
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.toolbar button[data-action]').forEach((button) => {
    button.addEventListener('mousedown', (event) => event.preventDefault());

    button.addEventListener('click', () => {
      if (!editor) return;

      const action = button.dataset.action;

      switch (action) {
        case 'bold': editor.chain().focus().toggleBold().run(); break;
        case 'italic': editor.chain().focus().toggleItalic().run(); break;
        case 'underline': editor.chain().focus().toggleUnderline().run(); break;
        case 'paragraph': editor.chain().focus().setParagraph().run(); break;
        case 'h2': editor.chain().focus().toggleHeading({ level: 2 }).run(); break;
        case 'h3': editor.chain().focus().toggleHeading({ level: 3 }).run(); break;
        case 'bullet': editor.chain().focus().toggleBulletList().run(); break;
        case 'ordered': editor.chain().focus().toggleOrderedList().run(); break;
        case 'blockquote': editor.chain().focus().toggleBlockquote().run(); break;
        case 'align-left': editor.chain().focus().setTextAlign('left').run(); break;
        case 'align-center': editor.chain().focus().setTextAlign('center').run(); break;
        case 'align-right': editor.chain().focus().setTextAlign('right').run(); break;
        case 'undo': editor.chain().focus().undo().run(); break;
        case 'redo': editor.chain().focus().redo().run(); break;

        case 'link': {
          // Corrected link attribute typing.
          const previous = (editor.getAttributes('link') as { href?: string }).href;
          const value = window.prompt('Enter the full link URL:', previous || 'https://');
          if (value === null) return;

          if (!value.trim()) {
            editor.chain().focus().unsetLink().run();
            return;
          }

          try {
            const url = new URL(value.trim());
            if (!['http:', 'https:', 'mailto:'].includes(url.protocol)) {
              throw new Error('Unsupported link protocol.');
            }
            editor.chain().focus().setLink({ href: url.toString() }).run();
          } catch {
            showMessage(formMessage, 'Enter a valid HTTP, HTTPS or email link.', 'error');
          }
          break;
        }

        case 'upload-image': {
          inlineImageInput?.click();
          break;
        }

        case 'image': {
          const value = window.prompt('Enter a publicly accessible image URL:');
          if (!value) return;

          try {
            const url = new URL(value.trim());
            if (!['http:', 'https:'].includes(url.protocol)) {
              throw new Error('Unsupported image protocol.');
            }
            editor.chain().focus().setImage({ src: url.toString(), alt: '' }).run();
          } catch {
            showMessage(formMessage, 'Enter a valid HTTP or HTTPS image URL.', 'error');
          }
          break;
        }
      }
    });
  });

  editor?.on('selectionUpdate', () => {
    document.querySelectorAll<HTMLButtonElement>('.toolbar button[data-action]').forEach((button) => {
      const action = button.dataset.action;
      const active =
        (action === 'bold' && editor.isActive('bold')) ||
        (action === 'italic' && editor.isActive('italic')) ||
        (action === 'underline' && editor.isActive('underline')) ||
        (action === 'bullet' && editor.isActive('bulletList')) ||
        (action === 'ordered' && editor.isActive('orderedList')) ||
        (action === 'blockquote' && editor.isActive('blockquote')) ||
        (action === 'h2' && editor.isActive('heading', { level: 2 })) ||
        (action === 'h3' && editor.isActive('heading', { level: 3 }));

      button.classList.toggle('is-active', Boolean(active));
    });
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!form || !saveButton || !editor) return;

    const formData = new FormData(form);
    const payload = {
      title: String(formData.get('title') ?? '').trim(),
      description: String(formData.get('description') ?? '').trim(),
      category: String(formData.get('category') ?? ''),
      body: editor.getHTML(),
      imageAlt: imageAltInput?.value.trim() ?? '',
      // Only send the image when it was added, replaced or removed, so an
      // untouched image on an existing article is kept as it is.
      ...(heroImageChanged || !currentEditingId ? { heroImageKey } : {}),
    };

    saveButton.disabled = true;
    saveButton.textContent = 'Saving...';
    showMessage(formMessage, '');

    try {
      const isEditing = Boolean(currentEditingId);
      const endpoint = isEditing
        ? `/api/articles/${encodeURIComponent(currentEditingId!)}`
        : '/api/articles';

      const response = await fetch(endpoint, {
        method: isEditing ? 'PATCH' : 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify(payload),
      });

      const data: { message?: string } = await response.json();

      if (!response.ok) {
        throw new Error(data.message || (isEditing
          ? 'The article changes could not be saved.'
          : 'The draft could not be saved.'));
      }

      // Reset first: resetEditor() clears the message, so show it afterwards.
      resetEditor();
      showMessage(
        formMessage,
        data.message || (isEditing ? 'Article changes saved.' : 'Draft saved.'),
        'success',
      );

      await loadArticles();
    } catch (error) {
      showMessage(
        formMessage,
        error instanceof Error ? error.message : 'The article could not be saved.',
        'error',
      );
    } finally {
      saveButton.disabled = false;

      if (!currentEditingId) {
        saveButton.textContent = 'Save draft';
      } else {
        saveButton.textContent = 'Save changes';
      }
    }
  });

  cancelEditButton?.addEventListener('click', () => {
    resetEditor();
  });

  refreshButton?.addEventListener('click', () => void loadArticles());

  async function initializeDashboard() {
    await loadArticles();

    const requestedArticleId = new URLSearchParams(window.location.search).get('edit');

    if (requestedArticleId) {
      await loadArticleForEditing(requestedArticleId);
    }
  }

  void initializeDashboard();

  window.addEventListener('beforeunload', () => editor?.destroy());
</script>