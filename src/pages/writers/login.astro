
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { verifyPassword } from '../../lib/auth';
import { env } from 'cloudflare:workers';

export const prerender = false;

let errorMessage = '';
let emailValue = '';

const MAX_ATTEMPTS = 5;
const WINDOW_SECONDS = 15 * 60;

// A valid-format hash of a random value nobody knows. Checked against when
// an email has no account, so every sign-in takes the same time.
const TIMING_DUMMY_HASH =
  'pbkdf2$sha256$600000$q8eIw2yQ0vS7m4pX1kZ3fA==$3J9QeVt2b0mY6xW1cR8sN5uL4kH7gF0dS2aZ9pO1iE4=';

type LoginAttemptRow = {
  total: number;
};

type AuthorRow = {
  id: string;
  display_name: string;
  role: string;
  password_hash: string | null;
};

type D1Query = {
  bind: (...values: (string | number | null)[]) => D1Query;
  first: <T>() => Promise<T | null>;
  run: () => Promise<unknown>;
};

type LoginDatabase = {
  prepare: (query: string) => D1Query;
};

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();

    const email = String(formData.get('email') ?? '')
      .trim()
      .toLowerCase();

    const password = String(formData.get('password') ?? '');

    emailValue = email;

    const db = (env as unknown as {
      DB?: LoginDatabase;
    }).DB;

    if (!db) {
      throw new Error(
        'Cloudflare D1 database binding is unavailable.',
      );
    }

    const ipAddress =
      Astro.request.headers.get('CF-Connecting-IP') || 'unknown';

    const now = Math.floor(Date.now() / 1000);
    const windowStart = now - WINDOW_SECONDS;

    const attempts = await db
      .prepare(
        `SELECT COUNT(*) AS total
         FROM login_attempts
         WHERE attempted_at > ?
           AND (email = ? OR ip_address = ?)`,
      )
      .bind(windowStart, email, ipAddress)
      .first<LoginAttemptRow>();

    if ((attempts?.total ?? 0) >= MAX_ATTEMPTS) {
      errorMessage =
        'Too many sign-in attempts. Please wait 15 minutes before trying again.';
    } else if (
      !email ||
      email.length > 254 ||
      !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ||
      password.length < 12 ||
      password.length > 256
    ) {
      errorMessage = 'Invalid email or password.';
    } else {
      const author = await db
        .prepare(
          `SELECT id, display_name, role, password_hash
           FROM authors
           WHERE email = ? AND active = 1
           LIMIT 1`,
        )
        .bind(email)
        .first<AuthorRow>();

      // Always run the (slow) password check, even when the email is
      // unknown, so response times don't reveal which emails have accounts.
      const passwordIsValid = await verifyPassword(
        password,
        author?.password_hash ?? TIMING_DUMMY_HASH,
      );

      if (!author || !author.password_hash || !passwordIsValid) {
        await db
          .prepare(
            `INSERT INTO login_attempts
              (email, ip_address, attempted_at)
             VALUES (?, ?, ?)`,
          )
          .bind(email, ipAddress, now)
          .run();

        // Housekeeping: forget failed attempts older than a day.
        await db
          .prepare(`DELETE FROM login_attempts WHERE attempted_at < ?`)
          .bind(now - 24 * 60 * 60)
          .run();

        errorMessage = 'Invalid email or password.';
      } else if (
        author.role !== 'admin' &&
        author.role !== 'writer' &&
        author.role !== 'editor'
      ) {
        errorMessage = 'Invalid email or password.';
      } else {
        const session = Astro.session;

        if (!session) {
          throw new Error(
            'Astro sessions are not available.',
          );
        }

        await db
          .prepare(
            `DELETE FROM login_attempts
             WHERE email = ? OR ip_address = ?`,
          )
          .bind(email, ipAddress)
          .run();

        await session.regenerate();

        await session.set('authorId', author.id);
        await session.set('authorRole', author.role);
        await session.set('authorName', author.display_name);

        if (author.role === 'admin') {
          return Astro.redirect('/admin/', 303);
        }

        return Astro.redirect('/writers/dashboard/', 303);
      }
    }
  } catch (error) {
    console.error('Writer sign-in failed:', error);

    errorMessage =
      'Sign-in is temporarily unavailable. Please try again.';
  }
}
---

<BaseLayout
  title="Writer Sign In | PTO Info Daily"
  description="Secure sign-in for authorised PTO Info Daily writers."
  noIndex={true}
>
  <main class="login-page">
    <section class="login-panel" aria-labelledby="login-heading">
      <a class="brand" href="/" aria-label="PTO Info Daily homepage">
        <img src="/pto-logo.png" alt="PTO Info Daily" />
      </a>

      <p class="eyebrow">PTO INFO DAILY</p>
      <h1 id="login-heading">Writer sign in</h1>

      <p class="intro">
        Sign in to manage your articles, save drafts and publish stories.
      </p>

      {errorMessage && (
        <p class="error-message" role="alert">
          {errorMessage}
        </p>
      )}

      <form method="POST" action="/writers/login/" class="login-form">
        <label for="email">Email address</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="username"
          placeholder="you@example.com"
          maxlength="254"
          value={emailValue}
          required
        />

        <label for="password">Password</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          placeholder="Enter your password"
          minlength="12"
          maxlength="256"
          required
        />

        <button type="submit">Sign in</button>
      </form>

      <p class="security-note">
        Authorised writers only. Accounts are created privately by the site
        administrator.
      </p>

      <a class="back-link" href="/">← Return to PTO Info Daily</a>
    </section>
  </main>
</BaseLayout>

<style>
  .login-page {
    min-height: 72vh;
    display: grid;
    place-items: center;
    padding: 48px 20px;
    background: #f3f5f8;
  }

  .login-panel {
    box-sizing: border-box;
    width: 100%;
    max-width: 440px;
    padding: 36px;
    background: #fff;
    border: 1px solid #e0e5ed;
    border-radius: 8px;
  }

  .brand {
    display: flex;
    justify-content: center;
    margin-bottom: 24px;
  }

  .brand img {
    display: block;
    width: auto;
    max-width: 190px;
    max-height: 72px;
    object-fit: contain;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: #155eef;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-align: center;
  }

  h1 {
    margin: 0;
    color: #102a56;
    font-size: 30px;
    line-height: 1.25;
    text-align: center;
  }

  .intro {
    margin: 12px 0 28px;
    color: #596579;
    font-size: 15px;
    line-height: 1.6;
    text-align: center;
  }

  .login-form {
    display: grid;
    gap: 10px;
  }

  label {
    margin-top: 8px;
    color: #172033;
    font-size: 14px;
    font-weight: 600;
  }

  input {
    box-sizing: border-box;
    width: 100%;
    min-height: 46px;
    padding: 12px;
    border: 1px solid #cbd3df;
    border-radius: 5px;
    background: #fff;
    color: #172033;
    font: inherit;
  }

  input:focus {
    border-color: #155eef;
    outline: 2px solid #d8e5ff;
    outline-offset: 1px;
  }

  button {
    min-height: 48px;
    margin-top: 16px;
    padding: 12px 16px;
    border: 0;
    border-radius: 5px;
    background: #155eef;
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  button:hover {
    background: #102a56;
  }

  .error-message {
    margin: 0 0 20px;
    padding: 12px;
    border: 1px solid #f1b8b8;
    border-radius: 5px;
    background: #fff1f1;
    color: #9f2020;
    font-size: 14px;
    line-height: 1.5;
  }

  .security-note {
    margin: 22px 0 18px;
    padding-top: 16px;
    border-top: 1px solid #e5e9f0;
    color: #667085;
    font-size: 12px;
    line-height: 1.6;
    text-align: center;
  }

  .back-link {
    display: block;
    color: #155eef;
    font-size: 14px;
    text-align: center;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .login-panel {
      padding: 28px 22px;
    }

    h1 {
      font-size: 26px;
    }
  }
</style>
