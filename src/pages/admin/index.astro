
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';

export const prerender = false;

const session = Astro.session;

if (!session) {
  return Astro.redirect('/writers/login/', 303);
}

const authorId = await session.get('authorId');

if (typeof authorId !== 'string' || !authorId) {
  return Astro.redirect('/writers/login/', 303);
}

const db = env.DB;

if (!db) {
  throw new Error('Cloudflare D1 database binding is unavailable.');
}

const administrator = await db
  .prepare(
    `SELECT id, display_name, email, role, active
     FROM authors
     WHERE id = ?
     LIMIT 1`,
  )
  .bind(authorId)
  .first<{
    id: string;
    display_name: string;
    email: string;
    role: string;
    active: number;
  }>();

if (
  !administrator ||
  administrator.active !== 1 ||
  administrator.role !== 'admin'
) {
  await session.destroy();
  return Astro.redirect('/writers/login/', 303);
}

const [
  publishedResult,
  draftResult,
  writerResult,
  suspendedResult,
  recentResult,
  writersResult,
] = await Promise.all([
  db
    .prepare(
      `SELECT COUNT(*) AS total
       FROM articles
       WHERE status = 'published'`,
    )
    .first<{ total: number }>(),

  db
    .prepare(
      `SELECT COUNT(*) AS total
       FROM articles
       WHERE status = 'draft'`,
    )
    .first<{ total: number }>(),

  db
    .prepare(
      `SELECT COUNT(*) AS total
       FROM authors
       WHERE role = 'writer' AND active = 1`,
    )
    .first<{ total: number }>(),

  db
    .prepare(
      `SELECT COUNT(*) AS total
       FROM authors
       WHERE role = 'writer' AND active = 0`,
    )
    .first<{ total: number }>(),

  db
    .prepare(
      `SELECT a.id, a.title, a.slug, a.category, a.status,
              a.review_status, a.updated_at,
              au.display_name AS author_name
       FROM articles a
       LEFT JOIN authors au ON au.id = a.author_id
       -- Articles waiting for review first, then approved-but-unpublished,
       -- then everything else by most recently updated.
       ORDER BY
         CASE
           WHEN a.review_status = 'submitted' THEN 0
           WHEN a.review_status = 'approved' AND a.status = 'draft' THEN 1
           ELSE 2
         END,
         a.updated_at DESC
       LIMIT 8`,
    )
    .all<{
      id: string;
      title: string;
      slug: string;
      category: string;
      status: string;
      review_status: string;
      updated_at: string;
      author_name: string | null;
    }>(),

  db
    .prepare(
      `SELECT
         a.id,
         a.display_name,
         a.email,
         a.active,
         a.created_at,
         CASE
           WHEN a.password_hash IS NOT NULL THEN 'activated'
           WHEN wi.used_at IS NOT NULL THEN 'used'
           WHEN wi.expires_at > ? THEN 'pending'
           WHEN wi.id IS NOT NULL THEN 'expired'
           ELSE 'not-invited'
         END AS invitation_status,
         wi.expires_at
       FROM authors a
       LEFT JOIN writer_invitations wi
         ON wi.author_id = a.id
       WHERE a.role = 'writer'
       ORDER BY a.created_at DESC`,
    )
    .bind(Math.floor(Date.now() / 1000))
    .all<{
      id: string;
      display_name: string;
      email: string;
      active: number;
      created_at: string;
      invitation_status: string;
      expires_at: number | null;
    }>(),
]);

const publishedCount = publishedResult?.total ?? 0;
const draftCount = draftResult?.total ?? 0;
const activeWriters = writerResult?.total ?? 0;
const suspendedWriters = suspendedResult?.total ?? 0;
const recentArticles = recentResult.results ?? [];
const writers = writersResult.results ?? [];

const categoryNames: Record<string, string> = {
  news: 'News',
  politics: 'Politics',
  entertainment: 'Entertainment',
  'celebrity-news': 'Celebrity News',
  trending: 'Trending Stories',
  sports: 'Sports',
  business: 'Business',
  lifestyle: 'Lifestyle',
  technology: 'Technology',
};

const reviewNames: Record<string, string> = {
  draft: 'Draft',
  submitted: 'Submitted',
  changes_requested: 'Changes requested',
  approved: 'Approved',
};
---

<BaseLayout
  title="Administrator Dashboard | PTO Info Daily"
  description="Private administration dashboard for PTO Info Daily."
  noIndex={true}
>
  <main class="admin-page">
    <header class="admin-header">
      <div class="header-inner">
        <a href="/" class="brand" aria-label="PTO Info Daily homepage">
          <img src="/pto-logo.png" alt="PTO Info Daily" />
        </a>

        <div class="header-account">
          <span class="admin-label">ADMINISTRATOR</span>
          <span class="account-name">{administrator.display_name}</span>

          <form method="POST" action="/writers/logout/">
            <button type="submit" class="logout-button">Sign out</button>
          </form>
        </div>
      </div>
    </header>

    <div class="admin-container">
      <div class="page-heading">
        <div>
          <p class="eyebrow">PUBLICATION MANAGEMENT</p>
          <h1>Administrator dashboard</h1>
          <p class="subtitle">
            Manage your publication, editorial team and articles from one place.
          </p>
        </div>

        <span class="admin-badge">Full access</span>
      </div>

      <section class="stats-grid" aria-label="Publication overview">
        <article class="stat-card">
          <span class="stat-label">Published articles</span>
          <strong>{publishedCount}</strong>
          <span class="stat-foot">Currently published</span>
        </article>

        <article class="stat-card">
          <span class="stat-label">Drafts</span>
          <strong>{draftCount}</strong>
          <span class="stat-foot">Awaiting publication</span>
        </article>

        <article class="stat-card">
          <span class="stat-label">Active writers</span>
          <strong>{activeWriters} / 3</strong>
          <span class="stat-foot">Maximum writer accounts</span>
        </article>

        <article class="stat-card">
          <span class="stat-label">Inactive writers</span>
          <strong>{suspendedWriters}</strong>
          <span class="stat-foot">Suspended or not activated</span>
        </article>
      </section>

      <section class="management-section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">EDITORIAL TEAM</p>
            <h2>Writer management</h2>
          </div>

          <span class="section-count">{writers.length} of 3 accounts</span>
        </div>

        <div class="management-panel">
          <div class="panel-copy">
            <h3>Invite a writer</h3>
            <p>
              Create a writer account using their name and email address.
              The writer will receive a one-time invitation link to set a password.
              The link expires after 24 hours.
            </p>

            <form id="writer-form" class="writer-form">
              <div class="form-field">
                <label for="writer-name">Writer's full name</label>
                <input
                  id="writer-name"
                  name="displayName"
                  type="text"
                  minlength="2"
                  maxlength="100"
                  autocomplete="name"
                  placeholder="Enter writer's name"
                  required
                />
              </div>

              <div class="form-field">
                <label for="writer-email">Writer's email address</label>
                <input
                  id="writer-email"
                  name="email"
                  type="email"
                  maxlength="254"
                  autocomplete="email"
                  placeholder="writer@example.com"
                  required
                />
              </div>

              <button
                id="create-writer-button"
                class="primary-button"
                type="submit"
                disabled={writers.length >= 3}
              >
                {writers.length >= 3 ? 'Writer limit reached' : 'Create writer invitation'}
              </button>
            </form>

            <p id="writer-message" class="message" role="status" aria-live="polite"></p>

            <div id="invitation-result" class="invitation-result" hidden>
              <h3>Invitation created</h3>
              <p>
                Copy this link and send it privately to the writer. It will
                only work once and expires in 24 hours.
              </p>

              <label for="invitation-url">One-time invitation link</label>
              <div class="copy-row">
                <input id="invitation-url" type="text" readonly />
                <button id="copy-invitation-button" class="secondary-button" type="button">
                  Copy link
                </button>
              </div>

              <p id="invitation-expiry" class="expiry-text"></p>
            </div>
          </div>
        </div>

        <div class="writer-list">
          <h3>Existing writer accounts</h3>

          {writers.length > 0 ? (
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Writer</th>
                    <th>Email</th>
                    <th>Account status</th>
                    <th>Invitation</th>
                    <th>Actions</th>
                  </tr>
                </thead>

                <tbody>
                  {writers.map((writer) => (
                    <tr>
                      <td>
                        <strong>{writer.display_name}</strong>
                        <span class="article-date">
                          Added {writer.created_at}
                        </span>
                      </td>

                      <td>{writer.email}</td>

                      <td>
                        <span class:list={[
                          'status',
                          writer.active === 1 ? 'status-published' : 'status-draft',
                        ]}>
                          {writer.active === 1 ? 'Active' : 'Inactive'}
                        </span>
                      </td>

                      <td>
                        {writer.invitation_status === 'activated'
                          ? 'Accepted'
                          : writer.invitation_status === 'pending'
                            ? `Pending — expires ${new Date(writer.expires_at! * 1000).toLocaleString()}`
                            : writer.invitation_status === 'expired'
                              ? 'Expired'
                              : writer.invitation_status === 'used'
                                ? 'Used'
                                : 'Not invited'}
                      </td>

                      <td>
                        <div class="writer-actions">
                          <button
                            type="button"
                            class="action-button"
                            data-writer-action={writer.active === 1 ? 'suspend' : 'reactivate'}
                            data-writer-id={writer.id}
                            data-writer-name={writer.display_name}
                          >
                            {writer.active === 1 ? 'Suspend' : 'Reactivate'}
                          </button>

                          <button
                            type="button"
                            class="action-button remove-button"
                            data-writer-action="remove"
                            data-writer-id={writer.id}
                            data-writer-name={writer.display_name}
                          >
                            Remove
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <div class="empty-state">
              <h3>No writer accounts yet</h3>
              <p>Create your first writer invitation using the form above.</p>
            </div>
          )}
        </div>
      </section>

      <section class="management-section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">CONTENT OPERATIONS</p>
            <h2>Recent articles</h2>
          </div>

          <span class="section-count">
            {publishedCount + draftCount} total
          </span>
        </div>

        {recentArticles.length > 0 ? (
          <div class="table-wrap">
            <table class="articles-table">
              <thead>
                <tr>
                  <th>Article</th>
                  <th>Author</th>
                  <th>Category</th>
                  <th>Publication</th>
                  <th>Editorial review</th>
                  <th>Actions</th>
                </tr>
              </thead>

              <tbody>
                {recentArticles.map((article) => (
                  <tr>
                    <td>
                      <span class="article-title">{article.title}</span>
                      <span class="article-date">
                        Updated {article.updated_at}
                      </span>
                    </td>

                    <td>{article.author_name ?? 'Unassigned'}</td>

                    <td>
                      {categoryNames[article.category] ?? article.category}
                    </td>

                    <td>
                      <span class:list={[
                        'status',
                        article.status === 'published'
                          ? 'status-published'
                          : 'status-draft',
                      ]}>
                        {article.status === 'published' ? 'Published' : 'Draft'}
                      </span>
                    </td>

                    <td>
                      <span class:list={[
                        'status',
                        article.review_status === 'approved'
                          ? 'status-published'
                          : article.review_status === 'submitted'
                            ? 'status-submitted'
                            : article.review_status === 'changes_requested'
                              ? 'status-changes'
                              : 'status-draft',
                      ]}>
                        {reviewNames[article.review_status] ?? 'Draft'}
                      </span>
                    </td>

                    <td>
                      <div class="article-actions">
                        <a
                          class="action-button"
                          href={`/writers/dashboard/?edit=${encodeURIComponent(article.id)}`}
                        >
                          Edit
                        </a>

                        {article.review_status === 'submitted' && (
                          <>
                            <button
                              type="button"
                              class="action-button approve-button"
                              data-article-action="approve"
                              data-article-id={article.id}
                              data-article-title={article.title}
                            >
                              Approve
                            </button>

                            <button
                              type="button"
                              class="action-button changes-button"
                              data-article-action="request_changes"
                              data-article-id={article.id}
                              data-article-title={article.title}
                            >
                              Request changes
                            </button>
                          </>
                        )}

                        {article.review_status === 'approved' &&
                          article.status !== 'published' && (
                            <>
                              <button
                                type="button"
                                class="action-button publish-button"
                                data-article-action="publish"
                                data-article-id={article.id}
                                data-article-title={article.title}
                              >
                                Publish
                              </button>

                              <button
                                type="button"
                                class="action-button changes-button"
                                data-article-action="request_changes"
                                data-article-id={article.id}
                                data-article-title={article.title}
                              >
                                Request changes
                              </button>
                            </>
                          )}

                        {article.status === 'published' && (
                          <button
                            type="button"
                            class="action-button changes-button"
                            data-article-action="unpublish"
                            data-article-id={article.id}
                            data-article-title={article.title}
                          >
                            Unpublish
                          </button>
                        )}

                        <button
                          type="button"
                          class="action-button remove-button"
                          data-article-action="delete"
                          data-article-id={article.id}
                          data-article-title={article.title}
                        >
                          Delete
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="empty-state">
            <h3>No articles yet</h3>
            <p>
              Articles will appear here once they are created in the publishing
              system.
            </p>
          </div>
        )}
      </section>

      <section class="account-section">
        <p class="eyebrow">SIGNED-IN ACCOUNT</p>
        <h2>Administrator details</h2>

        <dl>
          <div>
            <dt>Display name</dt>
            <dd>{administrator.display_name}</dd>
          </div>

          <div>
            <dt>Email address</dt>
            <dd>{administrator.email}</dd>
          </div>

          <div>
            <dt>Role</dt>
            <dd>Administrator</dd>
          </div>
        </dl>
      </section>
    </div>

    <footer class="admin-footer">
      <span>© {new Date().getFullYear()} PTO Info Daily</span>
      <a href="/">View public website</a>
    </footer>
  </main>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#writer-form');
  const message = document.querySelector<HTMLElement>('#writer-message');
  const createButton = document.querySelector<HTMLButtonElement>(
    '#create-writer-button',
  );
  const resultPanel = document.querySelector<HTMLElement>('#invitation-result');
  const invitationInput = document.querySelector<HTMLInputElement>('#invitation-url');
  const expiryText = document.querySelector<HTMLElement>('#invitation-expiry');
  const copyButton = document.querySelector<HTMLButtonElement>(
    '#copy-invitation-button',
  );

  // Writer invitation creation
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (
      !form ||
      !message ||
      !createButton ||
      !resultPanel ||
      !invitationInput ||
      !expiryText
    ) return;

    message.textContent = '';
    resultPanel.hidden = true;
    createButton.disabled = true;
    createButton.textContent = 'Creating invitation…';

    const formData = new FormData(form);

    try {
      const response = await fetch('/api/admin/writers/', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: JSON.stringify({
          displayName: formData.get('displayName'),
          email: formData.get('email'),
        }),
      });

      const data: {
        message?: string;
        invitationUrl?: string;
        expiresAt?: number;
      } = await response.json();

      if (!response.ok) {
        throw new Error(
          typeof data.message === 'string'
            ? data.message
            : 'Unable to create the invitation.',
        );
      }

      if (typeof data.invitationUrl !== 'string') {
        throw new Error('The server did not return an invitation link.');
      }

      invitationInput.value = data.invitationUrl;

      expiryText.textContent = data.expiresAt
        ? `Expires: ${new Date(data.expiresAt * 1000).toLocaleString()}`
        : 'The invitation expires in 24 hours.';

      resultPanel.hidden = false;
      message.textContent = data.message || 'Invitation created successfully.';
      form.reset();

      createButton.textContent = 'Invitation created';
      createButton.disabled = true;
    } catch (error) {
      message.textContent =
        error instanceof Error
          ? error.message
          : 'Something went wrong. Please try again.';

      createButton.disabled = false;
      createButton.textContent = 'Create writer invitation';
    }
  });

  // Copy writer invitation link
  copyButton?.addEventListener('click', async () => {
    if (!invitationInput || !copyButton) return;

    try {
      await navigator.clipboard.writeText(invitationInput.value);
      copyButton.textContent = 'Copied';
    } catch {
      invitationInput.focus();
      invitationInput.select();
      copyButton.textContent = 'Select and copy';
    }
  });

  // Suspend, reactivate and remove writer accounts
  document
    .querySelectorAll<HTMLButtonElement>('[data-writer-action]')
    .forEach((button) => {
      button.addEventListener('click', async () => {
        const action = button.dataset.writerAction;
        const writerId = button.dataset.writerId;
        const writerName = button.dataset.writerName || 'this writer';

        if (!action || !writerId) return;

        if (action === 'remove') {
          const confirmed = window.confirm(
            `Permanently remove ${writerName}?\n\nTheir articles will be transferred to the administrator before their account is deleted.`,
          );

          if (!confirmed) return;
        }

        if (action === 'suspend') {
          const confirmed = window.confirm(
            `Suspend ${writerName}'s account?\n\nThey will no longer be able to access the writers' portal.`,
          );

          if (!confirmed) return;
        }

        if (action === 'reactivate') {
          const confirmed = window.confirm(
            `Reactivate ${writerName}'s account?`,
          );

          if (!confirmed) return;
        }

        button.disabled = true;
        const originalText = button.textContent;

        button.textContent = 'Processing…';

        try {
          const response = await fetch(
            `/api/admin/writers/${encodeURIComponent(writerId)}`,
            {
              method: action === 'remove' ? 'DELETE' : 'PATCH',
              credentials: 'same-origin',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
              },
              ...(action === 'remove'
                ? {}
                : {
                    body: JSON.stringify({ action }),
                  }),
            },
          );

          const data: { message?: string } = await response.json();

          if (!response.ok) {
            throw new Error(
              data.message || 'The action could not be completed.',
            );
          }

          window.alert(data.message || 'Writer account updated.');
          window.location.reload();
        } catch (error) {
          window.alert(
            error instanceof Error
              ? error.message
              : 'Something went wrong. Please try again.',
          );

          button.disabled = false;
          button.textContent = originalText;
        }
      });
    });

  // Article management
  document
    .querySelectorAll<HTMLButtonElement>('[data-article-action]')
    .forEach((button) => {
      button.addEventListener('click', async () => {
        const action = button.dataset.articleAction;
        const articleId = button.dataset.articleId;
        const articleTitle = button.dataset.articleTitle || 'this article';

        if (!action || !articleId) return;

        const confirmations: Record<string, string> = {
          approve: `Approve "${articleTitle}" for publication? This will not publish it automatically.`,
          request_changes: `Return "${articleTitle}" to its writer for changes?`,
          publish: `Publish "${articleTitle}" on the public website?`,
          unpublish: `Unpublish "${articleTitle}" from the public website?`,
          delete: `Permanently delete "${articleTitle}"? This cannot be undone.`,
        };

        const confirmation = confirmations[action];

        if (!confirmation || !window.confirm(confirmation)) return;

        button.disabled = true;
        const originalText = button.textContent;
        button.textContent = 'Processing…';

        try {
          const isDelete = action === 'delete';

          const response = await fetch(
            `/api/articles/${encodeURIComponent(articleId)}`,
            {
              method: isDelete ? 'DELETE' : 'PATCH',
              credentials: 'same-origin',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
              },
              ...(isDelete
                ? {}
                : {
                    body: JSON.stringify({ action }),
                  }),
            },
          );

          const data: { message?: string } = await response.json();

          if (!response.ok) {
            throw new Error(
              data.message || 'The article action could not be completed.',
            );
          }

          window.alert(data.message || 'Article updated successfully.');
          window.location.reload();
        } catch (error) {
          window.alert(
            error instanceof Error
              ? error.message
              : 'Something went wrong. Please try again.',
          );

          button.disabled = false;
          button.textContent = originalText;
        }
      });
    });
</script>

<style>
  .admin-page {
    min-height: 75vh;
    background: #f3f5f8;
    color: #172033;
  }

  .admin-header {
    background: #102a56;
    color: #fff;
  }

  .header-inner {
    max-width: 1240px;
    min-height: 82px;
    margin: 0 auto;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand img {
    display: block;
    width: auto;
    max-width: 175px;
    max-height: 58px;
    object-fit: contain;
  }

  .header-account {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .admin-label {
    padding: 5px 8px;
    border: 1px solid #60769a;
    border-radius: 3px;
    color: #e2eaff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .account-name {
    font-size: 13px;
    font-weight: 600;
  }

  .header-account form {
    margin: 0;
  }

  .logout-button {
    padding: 8px 12px;
    border: 1px solid #b9c9e5;
    border-radius: 4px;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }

  .logout-button:hover {
    background: #1a3b70;
  }

  .admin-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 38px 24px 60px;
  }

  .page-heading,
  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .page-heading {
    margin-bottom: 30px;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: #155eef;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.3px;
  }

  h1, h2, h3, p {
    overflow-wrap: anywhere;
  }

  h1 {
    margin: 0;
    color: #102a56;
    font-size: clamp(26px, 4vw, 34px);
    line-height: 1.2;
  }

  .subtitle {
    margin: 10px 0 0;
    color: #667085;
    font-size: 15px;
