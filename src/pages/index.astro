
---
import { getPublishedArticles } from "../lib/public-articles";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const categoryLinks = [
  { label: "News", slug: "news" },
  { label: "Politics", slug: "politics" },
  { label: "Entertainment", slug: "entertainment" },
  { label: "Celebrity News", slug: "celebrity-news" },
  { label: "Trending", slug: "trending" },
  { label: "Sports", slug: "sports" },
  { label: "Business", slug: "business" },
  { label: "Lifestyle", slug: "lifestyle" },
  { label: "Technology", slug: "technology" },
];

export const prerender = false;

// Published D1 articles + non-draft Markdown articles, newest first.
const publishedArticles = await getPublishedArticles();

const articleUrl = (article: { id: string }): string =>
  `/news/${article.id}/`;

const categoryUrl = (category: string): string =>
  `/category/${category}/`;

const categoryName = (slug: string): string =>
  categoryLinks.find((category) => category.slug === slug)?.label ??
  slug.replaceAll("-", " ");

const formatDate = (date: Date): string =>
  date.toLocaleDateString("en-NG", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });

const leadStory = publishedArticles[0];
const sideStories = publishedArticles.slice(1, 3);
const latestStories = publishedArticles.slice(0, 6);

const trendingTopics = [
  { label: "News", slug: "news" },
  { label: "Entertainment", slug: "entertainment" },
  { label: "Politics", slug: "politics" },
  { label: "Business", slug: "business" },
];
---

<BaseLayout
  title="PTO Info Daily | Nigerian News, Entertainment and More"
  description="PTO Info Daily covers Nigerian news, politics, entertainment, celebrity stories, business, sports, lifestyle and technology."
  canonicalUrl="https://ptoinfodaily.com/"
  ogType="website"
  ogImage="/og-image.jpg"
>
  <SiteHeader />

  <main>
    <section class="container lead-section" aria-labelledby="daily-brief">
      <div class="section-heading">
        <span class="section-marker" aria-hidden="true"></span>
        <h2 id="daily-brief">THE DAILY BRIEF</h2>
        <span class="section-rule" aria-hidden="true"></span>
        <span class="section-date">News that matters</span>
      </div>

      {leadStory ? (
        <div class="lead-grid">
          <article class="lead-story">
            <a href={articleUrl(leadStory)} class="story-image lead-image">
              {leadStory.data.heroImage ? (
                <img
                  src={leadStory.data.heroImage}
                  alt={leadStory.data.imageAlt || leadStory.data.title}
                  fetchpriority="high"
                  width="1200"
                  height="700"
                />
              ) : (
                <div class="image-placeholder">
                  <span>PTO INFO DAILY</span>
                </div>
              )}
              <span class="image-label">TOP STORY</span>
            </a>

            <div class="lead-copy">
              <a
                class="category-label"
                href={categoryUrl(leadStory.data.category)}
              >
                {categoryName(leadStory.data.category).toUpperCase()}
              </a>
              <h1>
                <a href={articleUrl(leadStory)}>{leadStory.data.title}</a>
              </h1>
              <p>{leadStory.data.description}</p>
              <div class="story-meta">
                <span>BY {leadStory.data.author.toUpperCase()}</span>
                <span aria-hidden="true">·</span>
                <time datetime={leadStory.data.pubDate.toISOString()}>
                  {formatDate(leadStory.data.pubDate)}
                </time>
              </div>
            </div>
          </article>

          <aside class="side-stories" aria-labelledby="also-making-news">
            <div class="side-heading">
              <h2 id="also-making-news">ALSO MAKING NEWS</h2>
              <span class="side-count">
                {String(sideStories.length).padStart(2, "0")} STORIES
              </span>
            </div>

            {sideStories.length > 0 ? (
              sideStories.map((story) => (
                <article class="side-story">
                  <a
                    href={articleUrl(story)}
                    class="story-image side-image"
                    aria-label={`Read ${story.data.title}`}
                  >
                    {story.data.heroImage ? (
                      <img
                        src={story.data.heroImage}
                        alt={story.data.imageAlt || story.data.title}
                        loading="lazy"
                        width="400"
                        height="300"
                      />
                    ) : (
                      <div class="image-placeholder">
                        <span>PTO</span>
                      </div>
                    )}
                  </a>

                  <div class="side-copy">
                    <a
                      class="category-label"
                      href={categoryUrl(story.data.category)}
                    >
                      {categoryName(story.data.category).toUpperCase()}
                    </a>
                    <h3>
                      <a href={articleUrl(story)}>{story.data.title}</a>
                    </h3>
                    <p>{story.data.description}</p>
                  </div>
                </article>
              ))
            ) : (
              <p class="side-empty">
                More stories will appear here as they are published.
              </p>
            )}
          </aside>
        </div>
      ) : (
        <div class="homepage-empty">
          <h1>Stories that keep you informed.</h1>
          <p>
            Welcome to PTO Info Daily. Our latest news and features will appear
            here as stories are published.
          </p>
          <a href="/category/news/">Explore News</a>
        </div>
      )}
    </section>

    <section class="trending-section" aria-labelledby="trending-title">
      <div class="container">
        <div class="trending-heading">
          <span class="trending-icon" aria-hidden="true">↗</span>
          <h2 id="trending-title">EXPLORE CATEGORIES</h2>
          <span class="trending-caption">Explore our coverage</span>
        </div>

        <div class="trending-topics">
          {trendingTopics.map((topic, index) => (
            <a href={categoryUrl(topic.slug)}>
              {topic.label}
              <span>{String(index + 1).padStart(2, "0")}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section
      class="container latest-section"
      id="latest"
      aria-labelledby="latest-title"
    >
      <div class="section-heading">
        <span class="section-marker" aria-hidden="true"></span>
        <h2 id="latest-title">THE LATEST</h2>
        <span class="section-rule" aria-hidden="true"></span>
        <a class="section-more" href="/category/news/">EXPLORE NEWS ↗</a>
      </div>

      {latestStories.length > 0 ? (
        <div class="latest-grid">
          {latestStories.map((story) => (
            <article class="latest-card">
              <a
                href={articleUrl(story)}
                class="story-image latest-image"
                aria-label={`Read ${story.data.title}`}
              >
                {story.data.heroImage ? (
                  <img
                    src={story.data.heroImage}
                    alt={story.data.imageAlt || story.data.title}
                    loading="lazy"
                    width="800"
                    height="500"
                  />
                ) : (
                  <div class="image-placeholder">
                    <span>PTO INFO DAILY</span>
                  </div>
                )}
              </a>

              <div class="latest-card-copy">
                <a
                  class="category-label"
                  href={categoryUrl(story.data.category)}
                >
                  {categoryName(story.data.category).toUpperCase()}
                </a>
                <h3>
                  <a href={articleUrl(story)}>{story.data.title}</a>
                </h3>
                <p>{story.data.description}</p>
                <div class="story-meta">
                  <span>BY {story.data.author.toUpperCase()}</span>
                  <span aria-hidden="true">·</span>
                  <time datetime={story.data.pubDate.toISOString()}>
                    {formatDate(story.data.pubDate)}
                  </time>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <h3>No published stories yet</h3>
          <p>
            Published articles will automatically appear in this section.
          </p>
        </div>
      )}
    </section>

    <section
      class="container category-feature"
      aria-labelledby="explore-title"
    >
      <div class="category-feature-copy">
        <span class="category-label">BEYOND THE HEADLINES</span>
        <h2 id="explore-title">More than just the news.</h2>
        <p>
          From public affairs and business to culture, sport and technology,
          explore the stories shaping how we live.
        </p>
      </div>

      <div class="category-feature-links">
        {categoryLinks
          .filter(({ slug }) =>
            ["politics", "sports", "lifestyle", "technology"].includes(slug)
          )
          .map((category) => (
            <a href={categoryUrl(category.slug)}>
              {category.label} <span>↗</span>
            </a>
          ))}
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 20px;
  }

  :global(body) {
    margin: 0;
    background: #fff;
    color: #172033;
    font-family: "Inter", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(img) {
    display: block;
    max-width: 100%;
  }

  :global(button),
  :global(a) {
    -webkit-tap-highlight-color: transparent;
  }

  :global(a:focus-visible),
  :global(button:focus-visible) {
    outline: 3px solid #38bdf8;
    outline-offset: 3px;
  }

  .container {
    width: min(1200px, calc(100% - 48px));
    margin-inline: auto;
  }

  .lead-section {
    padding-top: 39px;
    padding-bottom: 38px;
  }

  .section-heading {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
  }

  .section-marker {
    display: block;
    width: 4px;
    height: 21px;
    flex-shrink: 0;
    background: #155eef;
  }

  .section-heading h2,
  .side-heading h2,
  .trending-heading h2 {
    margin: 0;
    font-family: "Montserrat", Arial, sans-serif;
    font-size: 13px;
    letter-spacing: .055em;
    font-weight: 800;
    color: #102a56;
  }

  .section-rule {
    flex: 1;
    height: 1px;
    background: #e3e8f0;
  }

  .section-date {
    color: #7a8495;
    font-size: 11px;
    white-space: nowrap;
  }

  .lead-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(290px, 1fr);
    gap: 30px;
  }

  .lead-story {
    min-width: 0;
  }

  .story-image {
    position: relative;
    display: block;
    overflow: hidden;
    background: #eaf2ff;
  }

  .story-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .35s ease;
  }

  .story-image:hover img {
    transform: scale(1.025);
  }

  .lead-image {
    height: 355px;
  }

  .image-label {
    position: absolute;
    bottom: 0;
    left: 0;
    background: #155eef;
    color: white;
    padding: 10px 15px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .08em;
  }

  .image-placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    min-height: 100px;
    place-items: center;
    background: #eaf2ff;
    color: #155eef;
    font-family: "Montserrat", Arial, sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .1em;
  }

  .lead-copy {
    padding-top: 20px;
  }

  .category-label {
    display: inline-block;
    color: #155eef;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .08em;
  }

  .lead-copy h1 {
    margin: 10px 0;
    max-width: 700px;
    color: #102a56;
    font-family: "Montserrat", Arial, sans-serif;
    font-size: clamp(27px, 3vw, 39px);
    line-height: 1.17;
    letter-spacing: -.045em;
    font-weight: 800;
  }

  .lead-copy h1 a:hover,
  .side-copy h3 a:hover,
  .latest-card-copy h3 a:hover {
    color: #155eef;
  }

  .lead-copy p,
  .side-copy p,
  .latest-card-copy p {
    color: #697386;
    font-size: 13px;
    line-height: 1.75;
  }

  .lead-copy p {
    max-width: 650px;
    margin: 0 0 16px;
  }

  .story-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    color: #8a94a5;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .035em;
  }

  .story-meta span {
    color: #155eef;
  }

  .side-stories {
    border-top: 2px solid #102a56;
  }

  .side-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid #e3e8f0;
  }

  .side-heading h2 {
    font-size: 11px;
  }

  .side-count {
    color: #929bad;
    font-size: 9px;
    font-weight: 700;
    white-space: nowrap;
  }

  .side-story {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 15px;
    padding: 18px 0;
    border-bottom: 1px solid #e3e8f0;
  }

  .side-image {
    height: 100px;
  }

  .side-copy {
    min-width: 0;
  }

  .side-copy h3 {
    margin: 7px 0;
    font-family: "Montserrat", Arial, sans-serif;
    color: #102a56;
    font-size: 15px;
    line-height: 1.4;
    letter-spacing: -.025em;
  }

  .side-copy p {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    margin: 0;
    font-size: 11px;
    line-height: 1.6;
  }

  .side-empty {
    color: #697386;
    font-size: 12px;
    line-height: 1.7;
  }

  .homepage-empty,
  .empty-state {
    padding: 30px 0;
    border-top: 1px solid #e3e8f0;
  }

  .homepage-empty h1,
  .empty-state h3 {
    color: #102a56;
    font-family: "Montserrat", Arial, sans-serif;
  }

  .homepage-empty p,
  .empty-state p {
    max-width: 620px;
    color: #697386;
    font-size: 13px;
    line-height: 1.8;
  }

  .homepage-empty > a {
    display: inline-block;
    margin-top: 8px;
    padding: 12px 16px;
    background: #155eef;
    color: white;
    font-size: 12px;
    font-weight: 700;
  }

  .trending-section {
    background: #f3f6fb;
    border-block: 1px solid #e5ebf5;
    padding: 24px 0;
  }

  .trending-heading {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-bottom: 18px;
  }

  .trending-icon {
    display: grid;
    place-items: center;
    width: 27px;
    height: 27px;
    flex-shrink: 0;
    background: #155eef;
    color: white;
    font-size: 17px;
  }

  .trending-heading h2 {
    font-size: 12px;
  }

  .trending-caption {
    margin-left: auto;
    color: #788398;
    font-size: 11px;
  }

  .trending-topics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .trending-topics a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 15px;
    background: white;
    border: 1px solid #e1e8f3;
    color: #102a56;
    font-size: 12px;
    font-weight: 700;
    transition: border-color .2s ease;
  }

  .trending-topics a:hover {
    border-color: #155eef;
  }

  .trending-topics a span {
    color: #155eef;
    font-size: 10px;
  }

  .latest-section {
    padding-top: 43px;
    padding-bottom: 44px;
  }

  .section-more {
    color: #155eef;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .04em;
    white-space: nowrap;
  }

  .latest-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .latest-card {
    min-width: 0;
  }

  .latest-image {
    height: 205px;
    margin-bottom: 16px;
  }

  .latest-card-copy h3 {
    margin: 8px 0;
    font-family: "Montserrat", Arial, sans-serif;
    color: #102a56;
    font-size: 18px;
    line-height: 1.4;
    letter-spacing: -.025em;
  }

  .latest-card-copy p {
    margin: 0 0 15px;
    font-size: 12px;
  }

  .category-feature {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 50px;
    align-items: center;
    margin-bottom: 50px;
    padding: 35px;
    background: #102a56;
    color: white;
  }

  .category-feature-copy .category-label {
    color: #8eb6ff;
  }

  .category-feature-copy h2 {
    margin: 12px 0;
    font-family: "Montserrat", Arial, sans-serif;
    font-size: clamp(24px, 3vw, 34px);
    letter-spacing: -.04em;
  }

  .category-feature-copy p {
    max-width: 470px;
    color: #d0d9e9;
    font-size: 13px;
    line-height: 1.8;
  }

  .category-feature-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 25px;
  }

  .category-feature-links a {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 0;
    border-bottom: 1px solid #344a6d;
    font-size: 13px;
    font-weight: 600;
  }

  .category-feature-links a span {
    color: #8eb6ff;
  }

  @media (max-width: 1050px) {
    .lead-grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(270px, 1fr);
      gap: 23px;
    }

    .side-story {
      grid-template-columns: 90px minmax(0, 1fr);
      gap: 12px;
    }

    .side-image {
      height: 88px;
    }
  }

  @media (max-width: 800px) {
    .container {
      width: min(calc(100% - 32px), 620px);
    }

    .lead-section {
      padding-top: 29px;
      padding-bottom: 28px;
    }

    .lead-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .lead-image {
      height: clamp(210px, 54vw, 350px);
    }

    .lead-copy h1 {
      font-size: clamp(28px, 6vw, 37px);
    }

    .side-story {
      grid-template-columns: 115px minmax(0, 1fr);
    }

    .side-image {
      height: 95px;
    }

    .trending-topics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .latest-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 25px 17px;
    }

    .latest-image {
      height: clamp(130px, 27vw, 190px);
    }

    .latest-card-copy h3 {
      font-size: 16px;
    }

    .category-feature {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 25px;
    }
  }

  @media (max-width: 460px) {
    .container {
      width: calc(100% - 28px);
    }

    .section-heading {
      gap: 8px;
    }

    .section-heading h2 {
      font-size: 11px;
    }

    .section-date {
      font-size: 9px;
    }

    .lead-image {
      height: 220px;
    }

    .lead-copy h1 {
      font-size: 28px;
    }

    .lead-copy p {
      font-size: 12px;
    }

    .side-story {
      grid-template-columns: 95px minmax(0, 1fr);
      gap: 12px;
    }

    .side-image {
      height: 90px;
    }

    .side-copy h3 {
      font-size: 13px;
    }

    .side-copy p {
      font-size: 10px;
    }

    .trending-heading {
      flex-wrap: wrap;
    }

    .trending-heading h2 {
      font-size: 11px;
    }

    .trending-caption {
      width: 100%;
      margin-left: 38px;
    }

    .trending-topics {
      gap: 8px;
    }

    .trending-topics a {
      padding: 12px 10px;
      font-size: 10px;
    }

    .latest-grid {
      gap: 24px 12px;
    }

    .latest-image {
      height: 125px;
      margin-bottom: 12px;
    }

    .latest-card-copy h3 {
      font-size: 14px;
    }

    .latest-card-copy p {
      font-size: 11px;
    }

    .category-feature {
      padding: 22px 18px;
    }

    .category-feature-links {
      gap: 0 15px;
    }

    .category-feature-links a {
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    .story-image img {
      transition: none;
    }
  }
</style>
