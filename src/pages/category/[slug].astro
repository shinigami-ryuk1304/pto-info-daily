
---
import { getPublishedArticlesByCategory } from "../../lib/public-articles";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";

export const prerender = false;

const categories = [
  { label: "News", slug: "news" },
  { label: "Politics", slug: "politics" },
  { label: "Entertainment", slug: "entertainment" },
  { label: "Celebrity News", slug: "celebrity-news" },
  { label: "Trending Stories", slug: "trending" },
  { label: "Sports", slug: "sports" },
  { label: "Business", slug: "business" },
  { label: "Lifestyle", slug: "lifestyle" },
  { label: "Technology", slug: "technology" },
];

const slug = Astro.params.slug;
const category = categories.find((item) => item.slug === slug);

if (!category) {
  // Show the branded "not found" page (it sends a real 404 status).
  return Astro.rewrite("/404");
}

// Published D1 articles + non-draft Markdown articles, newest first.
const articles = await getPublishedArticlesByCategory(category.slug);

const articleUrl = (article: { id: string }): string =>
  `/news/${article.id}/`;

const formatDate = (date: Date): string =>
  date.toLocaleDateString("en-NG", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });

const canonicalUrl = `https://ptoinfodaily.com/category/${category.slug}/`;

const description = `Read the latest ${category.label.toLowerCase()} stories, reports and updates from PTO Info Daily.`;
---

<BaseLayout
  title={`${category.label} | PTO Info Daily`}
  description={description}
  canonicalUrl={canonicalUrl}
>
  <SiteHeader />

  <main class="category-page">
    <header class="category-header">
      <p class="eyebrow">PTO INFO DAILY / CATEGORIES</p>
      <h1>{category.label}</h1>
      <p class="category-description">{description}</p>
      <p class="article-count">
        {articles.length} {articles.length === 1 ? "story" : "stories"} published
      </p>
    </header>

    {articles.length > 0 ? (
      <section
        class="article-grid"
        aria-label={`${category.label} articles`}
      >
        {articles.map((article, index) => (
          <article
            class:list={["article-card", index === 0 && "featured-card"]}
          >
            <a
              class="article-image"
              href={articleUrl(article)}
              aria-label={`Read ${article.data.title}`}
            >
              {article.data.heroImage ? (
                <img
                  src={article.data.heroImage}
                  alt={article.data.imageAlt || article.data.title}
                  loading={index === 0 ? "eager" : "lazy"}
                  width="800"
                  height="500"
                />
              ) : (
                <div class="image-placeholder">
                  <span>PTO INFO DAILY</span>
                </div>
              )}
            </a>

            <div class="article-copy">
              <p class="article-category">
                {category.label.toUpperCase()}
              </p>

              <h2>
                <a href={articleUrl(article)}>
                  {article.data.title}
                </a>
              </h2>

              <p class="article-description">
                {article.data.description}
              </p>

              <div class="article-meta">
                <span>By {article.data.author}</span>
                <time datetime={article.data.pubDate.toISOString()}>
                  {formatDate(article.data.pubDate)}
                </time>
              </div>
            </div>
          </article>
        ))}
      </section>
    ) : (
      <section class="empty-state">
        <h2>No stories in this category yet</h2>
        <p>
          New {category.label.toLowerCase()} stories will appear here when they
          are published.
        </p>
        <a href="/">Return to the homepage</a>
      </section>
    )}
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .category-page {
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
    padding: 48px 0 80px;
    color: #172033;
    font-family: "Inter", Arial, sans-serif;
  }

  .category-header {
    padding-bottom: 28px;
    margin-bottom: 30px;
    border-bottom: 1px solid #e3e8f0;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: #155eef;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .category-header h1 {
    margin: 0;
    color: #102a56;
    font-family: "Montserrat", Arial, sans-serif;
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.15;
  }

  .category-description {
    max-width: 700px;
    margin: 14px 0;
    color: #697386;
    font-size: 15px;
    line-height: 1.8;
  }

  .article-count {
    margin: 18px 0 0;
    color: #8a94a5;
    font-size: 12px;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 34px 24px;
  }

  .article-card {
    min-width: 0;
  }

  .article-image {
    display: block;
    overflow: hidden;
    aspect-ratio: 8 / 5;
    background: #eaf2ff;
  }

  .article-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .article-image:hover img {
    transform: scale(1.025);
  }

  .image-placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    color: #155eef;
    font-family: "Montserrat", Arial, sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .article-copy {
    padding-top: 17px;
  }

  .article-category {
    margin: 0 0 9px;
    color: #155eef;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .article-copy h2 {
    margin: 0 0 10px;
    color: #102a56;
    font-family: "Montserrat", Arial, sans-serif;
    font-size: 20px;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: -0.025em;
  }

  .article-copy h2 a {
    color: inherit;
    text-decoration: none;
  }

  .article-copy h2 a:hover {
    color: #155eef;
  }

  .article-description {
    margin: 0 0 16px;
    color: #697386;
    font-size: 13px;
    line-height: 1.75;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    color: #8a94a5;
    font-size: 11px;
  }

  .featured-card {
    grid-column: span 2;
  }

  .featured-card .article-image {
    aspect-ratio: 16 / 8;
  }

  .featured-card .article-copy h2 {
    font-size: clamp(23px, 3vw, 30px);
  }

  .empty-state {
    padding: 36px 0 20px;
    border-top: 1px solid #e3e8f0;
  }

  .empty-state h2 {
    margin: 0 0 12px;
    color: #102a56;
    font-family: "Montserrat", Arial, sans-serif;
    font-size: 24px;
  }

  .empty-state p {
    color: #697386;
    font-size: 14px;
    line-height: 1.8;
  }

  .empty-state a {
    display: inline-block;
    margin-top: 10px;
    color: #155eef;
    font-size: 13px;
    font-weight: 700;
  }

  @media (max-width: 800px) {
    .category-page {
      width: min(calc(100% - 32px), 620px);
      padding-top: 32px;
    }

    .article-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 18px;
    }

    .featured-card {
      grid-column: span 2;
    }
  }

  @media (max-width: 480px) {
    .category-page {
      width: calc(100% - 28px);
      padding-bottom: 56px;
    }

    .category-description {
      font-size: 13px;
    }

    .article-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .featured-card {
      grid-column: auto;
    }

    .featured-card .article-image,
    .article-image {
      aspect-ratio: 8 / 5;
    }

    .article-copy h2 {
      font-size: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-image img {
      transition: none;
    }
  }
</style>
